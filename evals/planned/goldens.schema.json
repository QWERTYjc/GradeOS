{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeOS grading generalization private goldens",
  "type": "object",
  "required": ["version", "dataset_id", "cases"],
  "properties": {
    "version": {"const": "grading-generalization-goldens-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "reference"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "reference": {
            "type": "object",
            "minProperties": 1
          },
          "requires_review": {"type": "boolean"},
          "relation_to_control": {
            "enum": ["semantic_equal", "meaning_changed", "review_required"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "relation_to_control": {"const": "review_required"}
              },
              "required": ["relation_to_control"]
            },
            "then": {
              "properties": {"requires_review": {"const": true}},
              "required": ["requires_review"]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

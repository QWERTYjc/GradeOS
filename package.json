{
  "name": "gradeos-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/workspace/server.mjs",
    "test:workspace": "node --test test/workspace*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "grade": "node src/run.mjs",
    "grade:cohort": "node src/run-cohort.mjs --scripted --model openai/gpt-6-luna --grading-reasoning medium --annotation-grid --inline-annotations",
    "grade:cohort:self-review": "node src/run-cohort.mjs --model openai/gpt-6.1-sol --worker-model openai/gpt-6-luna --student-protocol evidence-v4 --reason-style brief-full-credit --economy-reporting --lean-reports --trim-white-margins --isolate-student-cache",
    "start": "node --env-file-if-exists=.env src/workspace/server.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "test:python": "node scripts/python.mjs -m unittest discover -s test -p test_*.py",
    "fixtures:check": "node scripts/python.mjs scripts/fixtures.py check",
    "fixtures:prepare": "node scripts/python.mjs scripts/fixtures.py prepare",
    "fixtures:evaluate": "node scripts/python.mjs scripts/fixtures.py evaluate",
    "fixtures:workspace": "node scripts/import-fixture.mjs",
    "check": "npm test && npm run test:python && npm run fixtures:check",
    "grade:cohort:macos": "node src/run-cohort.mjs --scripted --model openai/gpt-6-luna --grading-reasoning medium --annotation-grid --inline-annotations --local-ocr",
    "medly:prepare": "node scripts/python.mjs scripts/medly.py",
    "check:public": "npm test && npm run test:python",
    "export:public": "node scripts/export-public.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "katex": "0.16.45"
  },
  "description": "Lightweight Pi-based grading workspace and GradeOS successor foundation",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/QWERTYjc/GradeOS.git"
  }
}
